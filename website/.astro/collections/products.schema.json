{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "eyebrow": {
      "type": "string"
    },
    "category": {
      "default": "Product",
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "command": {
      "type": "string"
    },
    "features": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "label",
          "detail"
        ]
      }
    },
    "metrics": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "value",
          "label"
        ]
      }
    },
    "accent": {
      "default": "teal",
      "type": "string",
      "enum": [
        "teal",
        "cyan",
        "violet",
        "amber",
        "rose"
      ]
    },
    "order": {
      "default": 0,
      "type": "number"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "tagline",
    "description",
    "eyebrow"
  ]
}