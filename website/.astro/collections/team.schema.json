{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "initials": {
      "type": "string",
      "minLength": 2,
      "maxLength": 3
    },
    "location": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "accent": {
      "type": "string",
      "enum": [
        "oxide",
        "cobalt",
        "citron",
        "violet",
        "moss",
        "amber"
      ]
    },
    "github": {
      "type": "string",
      "format": "uri"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "role",
    "bio",
    "initials",
    "order",
    "accent"
  ]
}